# MedReconcile MCP Server Configuration

# Server mode: "fixture" (synthetic data, no external deps) or "fhir" (live FHIR server)
MCP_MODE=fixture

# Server port
PORT=3333

# API keys for MCP client authentication (comma-separated)
MCP_API_KEYS=dev-test-key

# Google Gemini API Key (for AI-powered analysis)
GEMINI_API_KEY=

# LLM settings
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=4096

# DRY_RUN mode: if true, LLM tools return deterministic fixtures without calling the API
DRY_RUN=true

# FHIR server settings (only needed in fhir mode)
DEFAULT_FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Security
MCP_ALLOW_PRIVATE_FHIR=false

# Logging
LOG_LEVEL=info
